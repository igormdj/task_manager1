<h1>Meus Projetos</h1>

<% @projects.each do |projeto| %>
    <div>
        <h2><%= projeto.title %></h2>
        <% if projeto.description.blank? %>
            <p><em>Sem descrição disponível</em></p>
        <% else %>
            <p><%= projeto.description %></p>
        <% end %>
        <%= link_to "Ver detalhes", project_path(projeto), class: "btn-ver" %>
        <%= link_to "Editar", edit_project_path(projeto), class: "btn-editar" %>
        <%= link_to "Excluir", project_path(projeto), data: { turbo_method: :delete, turbo_confirm: "Confirma?" }, class: "btn-deletar" %>
    </div>
    <hr>
<% end %>

<%= link_to "Criar Novo Projeto", new_project_path, class: "bg-cyan-600 text-white px-6 py-2 rounded-full hover:bg-cyan-500 inline-block mb-6" %>
