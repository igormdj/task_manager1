<h1><%= @project.title %></h1>
<p><%= @project.description %></p>

<hr>

<h2>Tarefas do Projeto</h2>

<!-- 1. Lista de Tarefas -->
<div id="tasks">
    <% @project.tasks.each do |task| %>
        <div style="border: 1px solid #ccc; padding: 10px; margin-bottom: 10px;">
            <strong><%= task.title %></strong>
            <p><%= task.description %></p>

            <!-- Novo botão de excluir a tarefa -->
            <%= link_to "Excluir Tarefa", project_task_path(@project, task), data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir esta tarefa?" }, style: "color: red; font-size:12px;" %>
        </div>
    <% end %>
</div>

<hr>

<!-- 2. Formulário para Adicionar Nova Tarefa -->
<h3>Adicionar Nova Tarefa</h3>

<%= form_with model: [ @project, Task.new ] do |f| %>
    <div>
        <%= f.label :title, "Título da Tarefa" %><br>
        <%= f.text_field :title %>
    </div>

    <div>
        <%= f.label :description, "Descrição da Tarefa" %><br>
        <%= f.text_area :description %>
    </div>

        <%= f.submit "Salvar Tarefa" %>
<% end %>

<br>
<%= link_to "Voltar para a lista", projects_path %>