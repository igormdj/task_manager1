<%# app/views/tasks/_task.html.erb %>
<div id="task_<%= task.id %>" class="bg-slate-800 border border-slate-700 p-5 rounded-lg flex items-center justify-between hover:border-cyan-500 transition-colors">
  <div class="flex items-center gap-4 flex-1">
    <%= button_to toggle_project_task_path(@project, task), method: :patch, class: "text-2xl" do %>
      <%= task.completed? ? "✅" : "⬜" %>
    <% end %>

    <div>
      <strong class="text-white text-lg <%= 'line-through text-slate-500' if task.completed? %>">
        <%= task.title %>
      </strong>
      
      <div class="mt-1">
        <span class="px-2 py-0.5 rounded text-xs font-bold uppercase 
          <%= task.priority == 'high' ? 'bg-red-600' : (task.priority == 'medium' ? 'bg-yellow-600' : 'bg-blue-600') %> 
          text-white">
          <%= task.priority.humanize %>
        </span>
      </div>

      <p class="text-slate-400 text-sm mt-1"><%= task.description %></p>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= link_to "Editar", edit_project_task_path(@project, task), class: "text-cyan-400 hover:text-cyan-300 text-sm" %>
    <%= link_to "Excluir", project_task_path(@project, task), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "text-red-500 text-sm" %>
  </div>
</div>